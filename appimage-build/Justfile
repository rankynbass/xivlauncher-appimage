create-appimage config-name="xivlauncher": extract-appimagetool (download config-name)
    #!/usr/bin/env python3
    import glob
    import os
    import re
    import shutil
    import subprocess
    import sys

    CONFIG_NAME = "{{ config-name }}"

    def sh(*args):
        return subprocess.run([str(a) for a in args], capture_output=True, text=True).stdout

    def mkdir_p(path):
        os.makedirs(path, exist_ok=True)

    def cp(src, dst):
        shutil.copy(src, dst)

    def cp_r(src, dst):
        shutil.copytree(src, dst, dirs_exist_ok=True)

    def mv(src, dst):
        shutil.move(src, dst)

    def rm_rf(path):
        if os.path.islink(path) or os.path.isfile(path):
            os.remove(path)
        elif os.path.isdir(path):
            shutil.rmtree(path, ignore_errors=True)

    def ln_sf(target, link):
        if os.path.islink(link) or os.path.exists(link):
            os.remove(link)
        os.symlink(target, link)

    def chmod_x(path):
        os.chmod(path, os.stat(path).st_mode | 0o111)

    def chmod_R_x(root):
        chmod_x(root)
        for dirpath, dirnames, filenames in os.walk(root):
            for name in dirnames + filenames:
                chmod_x(os.path.join(dirpath, name))

    def read_file(path):
        with open(path) as f:
            return f.read()

    def write_file(path, content):
        with open(path, "w") as f:
            f.write(content)

    def fmt(template, **values):
        return re.sub(r"%\{(\w+)\}", lambda m: str(values[m.group(1)]), template)

    def relative_to(path, start):
        return os.path.relpath(path, start)

    def gcv(key, optional=False):
        try:
            out = sh("just", "get-config-value", CONFIG_NAME, key)
        except Exception:
            out = ""
        if out and out.strip():
            return out.strip()
        if not optional:
            sys.exit("no key '%s' found for config %s" % (key, CONFIG_NAME))
        return None

    def set_rpath(obj, rpath):
        print("set_rpath (%s): %s" % (obj, rpath))
        sh("{{ patchelf }}", "--set-rpath", rpath, obj)

    XIVLAUNCHER_EXEC_NAME = gcv("executable")
    XIVLAUNCHER_VERSION = gcv("version")
    XIVLAUNCHER_SOURCE = gcv("src")
    XIVLAUNCHER_NAME = gcv("name")
    XIVLAUNCHER_SHORT_NAME = gcv("short_name")
    XIVLAUNCHER_DESC = gcv("description")
    XIVLAUNCHER_RELEASE_TYPE = gcv("release_type")

    _packages = gcv("packages", True)
    XIVLAUNCHER_PACKAGES = [p.strip() for p in _packages.split(";")] if _packages else []
    _remove_files = gcv("remove_files", True)
    XIVLAUNCHER_REMOVE_FILES = [f.strip() for f in _remove_files.split(";")] if _remove_files else []

    PWD = os.getcwd()
    APPDIR = os.path.join(PWD, "appdir", XIVLAUNCHER_EXEC_NAME)
    INSTALL_PATH = os.path.join(APPDIR, "opt", XIVLAUNCHER_EXEC_NAME)
    DESKTOP_FILE_PATH = os.path.join(APPDIR, "usr", "share", "applications", XIVLAUNCHER_EXEC_NAME + ".desktop")
    ICON_PATH = os.path.join(APPDIR, "usr", "share", "icons", XIVLAUNCHER_EXEC_NAME + ".png")
    OUTPUT_DIR = os.path.join(PWD, "output")
    mkdir_p(OUTPUT_DIR)

    BINDIR = os.path.join(APPDIR, "usr", "bin")
    LIBDIR = os.path.join(APPDIR, "usr", "lib")
    EXECUTABLE_INSTALL_PATH = os.path.join(APPDIR, "AppRun")
    BUSYBOX_INSTALL_PATH = os.path.join(BINDIR, "busybox")
    ARIA2C_INSTALL_PATH = os.path.join(BINDIR, "aria2c")
    XDG_OPEN_INSTALL_PATH = os.path.join(BINDIR, "xdg-open")

    UPDATE_DATA = "gh-releases-zsync|rankynbass|XIVLauncher.Core|%s|%s-x86_64.AppImage.zsync" % (
        XIVLAUNCHER_RELEASE_TYPE,
        XIVLAUNCHER_NAME,
    )

    mkdir_p(os.path.join(PWD, "appdir"))
    cp_r("AppDir.template", APPDIR)
    cp_r(os.path.join(PWD, "src", CONFIG_NAME), INSTALL_PATH)
    cp(os.path.join("resources", "xivlauncher.png"), ICON_PATH)

    cp("{{ aria2c }}", ARIA2C_INSTALL_PATH)
    cp("{{ busybox }}", BUSYBOX_INSTALL_PATH)
    cp("{{ xdg_open }}", XDG_OPEN_INSTALL_PATH)
    for applet in sh(BUSYBOX_INSTALL_PATH, "--list").split("\n"):
        applet = applet.strip()
        if applet:
            ln_sf(relative_to(BUSYBOX_INSTALL_PATH, BINDIR), os.path.join(BINDIR, applet))

    appimage_version = sh(
        "{{ git }}", "describe", "--tags", "--match", XIVLAUNCHER_SHORT_NAME + "*"
    ).strip().replace(XIVLAUNCHER_SHORT_NAME + "/", "", 1)

    desktop_file = fmt(
        read_file(os.path.join("resources", "xivlauncher.desktop")),
        name=XIVLAUNCHER_NAME,
        description=XIVLAUNCHER_DESC,
        executable=XIVLAUNCHER_EXEC_NAME,
        appimage_version=appimage_version,
    )
    write_file(DESKTOP_FILE_PATH, desktop_file)

    launcher_script = fmt(
        read_file(os.path.join("resources", "xivlauncher.sh")),
        executable=XIVLAUNCHER_EXEC_NAME,
    )
    write_file(EXECUTABLE_INSTALL_PATH, launcher_script)
    chmod_x(EXECUTABLE_INSTALL_PATH)

    for remove_file in XIVLAUNCHER_REMOVE_FILES:
        rm_rf(os.path.join(INSTALL_PATH, remove_file))

    if "cimgui.so" in XIVLAUNCHER_REMOVE_FILES or "ImGuiImplSDL3.so" in XIVLAUNCHER_REMOVE_FILES:
        sh("just", "download-imgui")
        for obj in glob.glob(os.path.join("{{ src_dir }}", "_build", "*.so")):
            cp(obj, INSTALL_PATH)

    objects = [os.path.join(INSTALL_PATH, "XIVLauncher.Core")]
    objects += glob.glob(os.path.join(INSTALL_PATH, "**", "*.so"), recursive=True)
    for obj in objects:
        sh("just", "copy-dependencies", obj, XIVLAUNCHER_EXEC_NAME)
        chmod_R_x(os.path.join(APPDIR, "usr", "lib"))

    for package in ["libjxr-dev", "libsecret-1-dev", "libicu-dev"] + XIVLAUNCHER_PACKAGES:
        sh("just", "copy-package-libraries", package, XIVLAUNCHER_EXEC_NAME)

    for obj in glob.glob(os.path.join(LIBDIR, "*")):
        set_rpath(obj, "$ORIGIN")

    for obj in glob.glob(os.path.join(INSTALL_PATH, "*.so")):
        set_rpath(obj, "$ORIGIN/../../usr/lib")

    set_rpath(os.path.join(INSTALL_PATH, "XIVLauncher.Core"), "$ORIGIN/../../usr/lib")

    ln_sf(relative_to(DESKTOP_FILE_PATH, APPDIR), os.path.join(APPDIR, XIVLAUNCHER_EXEC_NAME + ".desktop"))
    ln_sf(relative_to(ICON_PATH, APPDIR), os.path.join(APPDIR, XIVLAUNCHER_EXEC_NAME + ".png"))

    sh(
        "{{ appimagetool }}.d/AppRun",
        "-u",
        UPDATE_DATA,
        APPDIR,
        os.path.join(OUTPUT_DIR, XIVLAUNCHER_NAME + "-{{ arch() }}.AppImage"),
    )

    for zsync in glob.glob("*.zsync"):
        mv(zsync, OUTPUT_DIR)

copy-dependencies source-object config-name:
    #!/usr/bin/env python3
    import os
    import re
    import shutil
    import subprocess

    LIBDIR = os.path.join(os.getcwd(), "appdir", "{{ config-name }}", "usr", "lib")
    os.makedirs(LIBDIR, exist_ok=True)

    SEARCHED_FILES = []
    EXCLUDED_LIBRARIES = set(
        "lib" + name
        for name in [
            "c", "stdc++", "dl", "rt", "pthread", "m", "gcc_s", "z", "zstd",
            "wayland-client", "wayland-cursor", "wayland-egl", "wayland-server",
            "xcb", "xkbcommon", "X11", "X11-xcb", "Xau", "Xcursor", "Xdmcp",
            "Xext", "Xfixes", "Xi", "Xrandr", "Xrender", "Xss", "drm",
        ]
    )

    def sh(*args):
        return subprocess.run([str(a) for a in args], capture_output=True, text=True).stdout

    def get_deps(src):
        objects = []
        if src in SEARCHED_FILES:
            return objects
        for line in sh("{{ ldd }}", src).split("\n"):
            match = re.match(r"^(.+) => (.+) \(0x[0-9a-f]+\)$", line.strip())
            if match:
                objects.append(match.group(2))
        SEARCHED_FILES.append(src)
        i = 0
        while i < len(objects):
            obj = objects[i]
            i += 1
            for dep in get_deps(obj):
                if dep not in objects:
                    objects.append(dep)
        return objects

    for lib in get_deps("{{ source-object }}"):
        destination = os.path.join(LIBDIR, os.path.basename(lib))
        excluded = os.path.basename(lib).split(".")[0] in EXCLUDED_LIBRARIES
        if not (os.path.exists(destination) or excluded):
            shutil.copy(lib, destination)

copy-package-libraries package-name config-name architecture="amd64":
    #!/usr/bin/env python3
    import os
    import re
    import shutil
    import subprocess

    LIBDIR = os.path.join(os.getcwd(), "appdir", "{{ config-name }}", "usr", "lib")

    listing = subprocess.run(
        ["{{ dpkg_query }}", "-L", "{{ package-name }}:{{ architecture }}"],
        capture_output=True,
        text=True,
    ).stdout

    objects = []
    for line in listing.split("\n"):
        match = re.match(r"^(.+\.so(\.\d)*)$", line.strip())
        if match:
            objects.append(match.group(1))

    for obj in objects:
        shutil.copy(obj, LIBDIR)
        subprocess.run(
            ["just", "copy-dependencies", obj, "{{ config-name }}"],
            capture_output=True,
            text=True,
        )

download config-name:
    #!/usr/bin/env python3
    import os
    import re
    import subprocess

    def sh(*args):
        return subprocess.run([str(a) for a in args], capture_output=True, text=True).stdout

    def mkdir_p(path):
        os.makedirs(path, exist_ok=True)

    def fmt(template, **values):
        return re.sub(r"%\{(\w+)\}", lambda m: str(values[m.group(1)]), template)

    def gcv(key):
        return sh("just", "get-config-value", "{{ config-name }}", key).strip()

    mkdir_p("{{ cache_dir }}")
    mkdir_p("{{ absolute_path('src') }}")

    executable = gcv("executable")
    bin_extract_dir = os.path.join("src", executable)
    mkdir_p(bin_extract_dir)

    archive_url = fmt(gcv("src"), version=gcv("version"))
    dest = os.path.join("{{ cache_dir }}", executable + ".tar.gz")

    if not os.path.exists(dest):
        sh("{{ wget }}", "-O", dest, archive_url)

    if not os.path.exists(os.path.join(bin_extract_dir, "XIVLauncher.Core")):
        sh("tar", "-xzf", dest, "-C", bin_extract_dir)

extract-appimagetool:
    #!/usr/bin/env bash
    set -ueox pipefail

    if [ ! -d "{{ appimagetool }}.d" ]; then
        (cd {{ tool_dir }} && "{{ appimagetool }}" --appimage-extract)
        mv "{{ tool_dir }}/squashfs-root" "{{ tool_dir }}/appimagetool.d"
    fi

download-imgui:
    #!/usr/bin/env bash
    set -ueox pipefail

    build_dir="{{ src_dir }}/_build"
    mkdir -p "{{ src_dir }}"
    mkdir -p "$build_dir"

    cflags="-DIMGUI_USE_WCHAR32=1 -DIMGUI_ENABLE_FREETYPE=1 -DIMGUI_ENABLE_STB_TRUETYPE=1 -DIMGUI_DISABLE_OBSOLETE_FUNCTIONS=1 -fPIC -shared"
    ldflags="-Wl,--no-undefined"

    cimgui_cflags="-DCIMGUI_FREETYPE=1 -DCIMGUI_VARGS0 -DIMGUI_USER_CONFIG=\"{{ src_dir }}/cimgui/cimconfig.h\" $(pkg-config --cflags freetype2) $cflags"
    cimgui_ldflags="$(pkg-config --libs freetype2) $ldflags"

    if [ ! -d "{{ src_dir }}/imgui" ]; then
        just git-clone https://github.com/ocornut/imgui {{ imgui_version }}
    fi

    if [ ! -x "$build_dir/cimgui.so" ]; then
        if [ ! -d "{{ src_dir }}/cimgui" ]; then
            just git-clone https://github.com/JunaMeinhold/cimgui docking_inter
            (cd "{{ src_dir }}/cimgui" && git checkout d61baefa0ce2a9db938ffdeb29e64f90f44cc037)
            rm -rf "{{ src_dir }}/cimgui/imgui"
            ln -s "{{ src_dir }}/imgui" "{{ src_dir }}/cimgui/imgui"
        fi
        cd "{{ src_dir }}/cimgui"
        (cd ./generator && ./generator.sh)
        "{{ gcc }}" -o "$build_dir/cimgui.so" \
        -I. -Iimgui -Iimgui/misc/freetype \
        $cimgui_cflags \
        imgui/imgui{,_draw,_widgets,_tables,_demo}.cpp \
        imgui/misc/freetype/imgui_freetype.cpp \
        {{ src_dir }}/cimgui/{cimgui,cimgui_impl}.cpp \
        $cimgui_ldflags
    fi

    cimgui_impl_cflags="-DCIMGUI_USE_SDL3 -DCIMGUI_USE_SDL3Renderer -DCIMGUI_USE_SDLGPU3 $(pkg-config --cflags sdl3) $cimgui_cflags"
    cimgui_impl_ldflags="$(pkg-config --libs sdl3) $cimgui_ldflags"

    if [ ! -x "$build_dir/ImGuiImplSDL3.so" ]; then
        if [ ! -d "{{ src_dir }}/cimgui_impl" ]; then
            just git-clone https://github.com/HexaEngine/cimgui_impl main
            (cd "{{ src_dir }}/cimgui_impl" && git checkout 7a459f54179587dc923749fed44ae34f78c370d3 && git submodule update --init --recursive)
        fi
        cd "{{ src_dir }}/cimgui_impl"
        "{{ gcc }}" \
        -o "$build_dir/ImGuiImplSDL3.so" \
        -Iimgui -Iimgui/backends -Iimgui/misc/freetype -Isrc -Iinclude \
        $cimgui_impl_cflags \
        src/cimgui_impl_{core,sdl3,sdl3renderer,sdlgpu3}.cpp \
        imgui/backends/imgui_impl_{sdl3,sdlrenderer3,sdlgpu3}.cpp \
        imgui/imgui{,_tables,_widgets,_draw,_demo}.cpp \
        imgui/misc/freetype/imgui_freetype.cpp \
        $cimgui_impl_ldflags
    fi

get-config-value name key:
    #!/usr/bin/env python3
    import json

    with open("{{ config_file }}") as f:
        config = json.load(f)

    value = config.get("{{ name }}", {}).get("{{ key }}")
    print("" if value is None else str(value))

