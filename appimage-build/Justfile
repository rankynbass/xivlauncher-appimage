@git-clone url branch="main" extra-args="" dest-name="":
    mkdir -p "{{ src_dir }}"
    echo "Cloning {{ url }}..."
    cd "{{ src_dir }}" && "{{ git }}" clone -q "{{ url }}" --single-branch --branch "{{ branch }}" {{ extra-args }} {{ dest-name }}
